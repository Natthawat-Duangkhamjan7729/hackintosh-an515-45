# Sensitive machine data: SMBIOS identity, firmware logs, Windows license table
**/SysReport/
**/firmware-evidence/opencore-*.txt
**/MSDM*.aml
**/MSDM*.dsl

# Generated identity values must never be committed
**/PlatformInfo*.plist
**/*serial*
**/*smbios-private*

# Large or redistributable binaries; reproducible from pinned upstream sources (see checksums.json)
**/installer/
**/downloads/*.zip
**/downloads/*.sucatalog
**/packages/
**/tools/*.exe
**/tools/UTBMap.kext/
**/tools/SSDTTime/
*.efi
**/components/Kexts/USBToolBox.kext/
**/candidate-*/EFI/OC/Kexts/*
!**/candidate-*/EFI/OC/Kexts/USBMap.kext/

# Local tool state
__pycache__/
*.pyc
.claude/settings.local.json
**/boot-logs/

# Third-party upstream clones used for research (separate git repos)
research/**/upstream/

# Private SMBIOS identity and builds that contain it (never commit)
**/private/
**/private-build/

# Sanitized export of the working USB/ESP lives in machines/AN515-45/final-efi/
# (the raw snapshot is in private/usb-snapshot-2026-10-11/)
**/final-efi/EFI/OC/Kexts/*
!**/final-efi/EFI/OC/Kexts/USBMap.kext/

# Verified duplicates waiting for the user to delete
/_delete-me/
